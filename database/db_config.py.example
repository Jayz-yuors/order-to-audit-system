import os
import psycopg2


def create_connection():
    return psycopg2.connect(
        host=os.getenv("PG_HOST", "localhost"),
        port=os.getenv("PG_PORT", "5432"),
        dbname=os.getenv("PG_DB", "DemoDb"),
        user=os.getenv("PG_USER", "postgres"),
        password=os.environ["PG_PASS"],
    )
